# All optional. With none of these set the repo runs fully offline with deterministic rules.
# ANTHROPIC_API_KEY=            # enables the Claude path for classifying free-text rep notes (validated, with fallback)
# ANTHROPIC_MODEL=claude-sonnet-4-5
# SOFL_PII_SALT=                # set your own salt before pointing this at real data; the demo salt is public
# Never commit a real .env. HubSpot/Salesforce credentials are NOT used by anything in this repo.
